{
  "name": "teamspeak-6-webui",
  "private": true,
  "scripts": {
    "dev": "pnpm --parallel -r run dev",
    "dev:backend": "pnpm --filter @ts6/backend run dev",
    "dev:frontend": "pnpm --filter @ts6/frontend run dev",
    "build": "pnpm -r run build",
    "db:generate": "pnpm --filter @ts6/backend exec prisma generate",
    "db:migrate": "pnpm --filter @ts6/backend exec prisma migrate dev",
    "db:seed": "pnpm --filter @ts6/backend exec prisma db seed",
    "lint": "eslint .",
    "test": "pnpm -r run test",
    "typecheck": "pnpm -r run typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.61.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "tar": "^7.5.19",
      "form-data": ">=4.0.6",
      "undici": "^6.28.1",
      "brace-expansion@1": "^1.1.21",
      "brace-expansion@5": "^5.0.12",
      "ip-address": "^10.7.1",
      "postcss": "^8.5.18",
      "deepmerge-ts": "^8.0.0",
      "zod": "^4.6.6"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-vfj7-8cjw-p6xm",
        "GHSA-rj75-hqrm-r3gf"
      ]
    }
  }
}
