generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String?
  displayName  String
  role         String    @default("viewer")
  enabled      Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  mfaEnabled       Boolean @default(false)
  mfaSecret        String? // encrypted TOTP secret
  mfaPendingSecret String? // encrypted, during enrollment
  mfaRecoveryCodes String? // encrypted JSON array of hashed one-time codes
  mfaRequired      Boolean @default(false) // admin-forced enrollment
  mustChangePassword Boolean @default(false) // force a password change at next login
  language         String? // UI language (en/fr/de/es/it); null = browser default

  authProvider String  @default("local") // "local" | "saml"
  externalId   String? // SAML nameID (stable key)

  serverAccess   UserServerAccess[]
  refreshTokens  RefreshToken[]
  trustedDevices TrustedDevice[]

  @@unique([authProvider, externalId])
}

model RefreshToken {
  id         Int      @id @default(autoincrement())
  token      String   @unique
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  family     String?
  replacedBy String?
}

model TrustedDevice {
  id           Int      @id @default(autoincrement())
  userId       Int
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  selector     String   @unique
  verifierHash String
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  userAgent    String?
  ipAddress    String?
}

model UserServerAccess {
  id             Int            @id @default(autoincrement())
  userId         Int
  serverConfigId Int
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)

  @@unique([userId, serverConfigId])
}

model TsServerConfig {
  id           Int      @id @default(autoincrement())
  name         String
  host         String
  webqueryPort Int      @default(10080)
  apiKey       String
  useHttps     Boolean  @default(false)
  sshPort      Int      @default(10022)
  sshUsername  String?
  sshPassword  String?
  /// SHA-256 fingerprint of the server's SSH host key, pinned on first connect
  /// (trust on first use). A later mismatch aborts the connection instead of
  /// handing the ServerQuery password to whoever answered.
  sshHostKeyFp String?
  enabled      Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userAccess    UserServerAccess[]
  botFlows      BotFlow[]
  botLogs       BotExecutionLog[]
  musicBots     MusicBot[]
  songs         Song[]
  playlists     Playlist[]
  radioStations RadioStation[]
  widgets       Widget[]
  musicRequests MusicRequest[]
}

model BotFlow {
  id              Int      @id @default(autoincrement())
  name            String
  description     String?
  flowData        String   @default("{\"nodes\":[],\"edges\":[]}")
  serverConfigId  Int
  virtualServerId Int      @default(1)
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  enabled         Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executions BotExecution[]
  variables  BotVariable[]
}

model BotVariable {
  id     Int     @id @default(autoincrement())
  flowId Int
  flow   BotFlow @relation(fields: [flowId], references: [id], onDelete: Cascade)
  name   String
  value  String  @default("")
  scope  String  @default("flow")

  @@unique([flowId, name, scope])
}

model BotExecution {
  id          Int       @id @default(autoincrement())
  flowId      Int
  flow        BotFlow   @relation(fields: [flowId], references: [id], onDelete: Cascade)
  triggeredBy String
  triggerData String?
  status      String    @default("running")
  startedAt   DateTime  @default(now())
  endedAt     DateTime?
  error       String?

  logs BotExecutionLog[]
}

model BotExecutionLog {
  id             Int            @id @default(autoincrement())
  executionId    Int?
  execution      BotExecution?  @relation(fields: [executionId], references: [id], onDelete: Cascade)
  serverConfigId Int
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id])
  flowId         Int?
  nodeId         String?
  nodeName       String?
  level          String         @default("info")
  message        String
  data           String?
  timestamp      DateTime       @default(now())

  @@index([executionId])
  @@index([flowId])
  @@index([timestamp])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// === Music / Voice Bot Models ===

model MusicBot {
  id              Int       @id @default(autoincrement())
  name            String
  serverConfigId  Int
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  nickname        String    @default("MusicBot")
  serverPassword  String?
  defaultChannel  String?
  channelPassword String?
  voicePort       Int       @default(9987)
  volume          Int       @default(50)
  identityData    String?
  autoStart       Boolean   @default(false)
  streamPreset    String    @default("720p")
  sidecarPort     Int       @default(9800)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  playlists Playlist[]
}

model Song {
  id              Int       @id @default(autoincrement())
  title           String
  artist          String?
  duration        Float?
  filePath        String
  source          String    @default("local")
  sourceUrl       String?
  fileSize        Int?
  serverConfigId  Int
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  playlistSongs PlaylistSong[]
}

model Playlist {
  id         Int       @id @default(autoincrement())
  name       String
  musicBotId Int?
  musicBot   MusicBot? @relation(fields: [musicBotId], references: [id], onDelete: SetNull)
  /// Scope. Song is already scoped per server config, so without this two
  /// TeamSpeak servers importing the same YouTube playlist would contend for
  /// one row and mix tracks from different libraries.
  serverConfigId Int?
  serverConfig   TsServerConfig? @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  /// YouTube playlist id, set on import. Null for hand-made playlists.
  sourceId   String?
  createdAt  DateTime  @default(now())

  songs PlaylistSong[]

  @@unique([serverConfigId, sourceId])
}

model PlaylistSong {
  id         Int      @id @default(autoincrement())
  playlistId Int
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
  songId     Int
  song       Song     @relation(fields: [songId], references: [id], onDelete: Cascade)
  position   Int      @default(0)

  @@unique([playlistId, songId])
}

model RadioStation {
  id             Int            @id @default(autoincrement())
  name           String
  url            String
  genre          String?
  imageUrl       String?
  serverConfigId Int
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
}

// === Server Widget / Banner ===

model Widget {
  id              Int            @id @default(autoincrement())
  name            String
  token           String         @unique
  serverConfigId  Int
  serverConfig    TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  virtualServerId Int            @default(1)
  theme           String         @default("dark")
  showChannelTree Boolean        @default(true)
  showClients     Boolean        @default(true)
  hideEmptyChannels Boolean      @default(false)
  maxChannelDepth Int            @default(5)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model MusicRequest {
  id             Int            @id @default(autoincrement())
  title          String
  url            String
  serverConfigId Int
  serverConfig   TsServerConfig @relation(fields: [serverConfigId], references: [id], onDelete: Cascade)
  requestedAt    DateTime       @default(now())

  @@unique([serverConfigId, url])
}

model StreamSession {
  id             Int       @id @default(autoincrement())
  musicBotId     Int
  source         String
  preset         String    @default("720p")
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  peakViewers    Int       @default(0)
}

model DiscordSettings {
  id                     Int      @id @default(autoincrement())
  enabled                Boolean  @default(false)
  botToken               String?
  guildId                String?
  notificationsChannelId String?
  statsChannelId         String?
  statsLiveEnabled       Boolean  @default(false)
  notifyConnections      Boolean  @default(true)
  notifyNowPlaying       Boolean  @default(true)
  notifyChannelId        String?
  notifyJoinTemplate     String?
  notifyLeaveTemplate    String?
  notifyEmbed            Boolean  @default(false)
  notifAutoDeleteSeconds Int      @default(0) // 0 = keep messages
  notifyAway             Boolean  @default(false)
  notifyAwayTemplate     String?
  notifyBackTemplate     String?
  flowMessageTrigger     Boolean  @default(false)
  commandRoleIds         String?  // JSON array of Discord role IDs; null/empty = open to everyone
  statsMessageId         String?
  voiceChannelId         String?
  defaultMusicBotId      Int?
  serverConfigId         Int?
  virtualServerId        Int      @default(1)
  updatedAt              DateTime @updatedAt
}

model SpotifySettings {
  id             Int      @id @default(autoincrement())
  enabled        Boolean  @default(false)
  clientId       String?
  clientSecret   String?
  maxAlbumTracks Int      @default(50)
  updatedAt      DateTime @updatedAt
}

model MusicCommandSettings {
  id               Int      @id @default(autoincrement())
  musicCommandSgid Int?     // server group allowed to run music commands (null = open to all)
  adminCommandSgid Int?     // server group allowed to run move/moveall/notif (null = open to all)
  notifyNowPlaying Boolean  @default(false) // post "now playing" in the bot's TS channel
  updatedAt        DateTime @updatedAt
}

model WebBan {
  id        Int       @id @default(autoincrement())
  ip        String    @unique
  reason    String?
  expiresAt DateTime? // null = permanent
  createdAt DateTime  @default(now())
}

model ConnectionLog {
  id             Int      @id @default(autoincrement())
  source         String   // 'web' | 'teamspeak'
  login          String
  ip             String
  country        String?  // ISO code, null for LAN/unknown
  success        Boolean  @default(true)
  isBot          Boolean  @default(false)
  serverConfigId Int?
  createdAt      DateTime @default(now())

  @@index([source, createdAt])
}

model SAMLSettings {
  id              Int      @id @default(autoincrement())
  enabled         Boolean  @default(false)
  idpMetadataUrl  String?
  idpMetadataXml  String?  // encrypted
  idpEntityId     String?
  idpSsoUrl       String?
  idpCertificate  String?  // encrypted (PEM/base64)
  spEntityId      String?
  autoProvision   Boolean  @default(true)
  defaultRole     String   @default("viewer")
  attrUsername    String   @default("http://schemas.goauthentik.io/2021/02/saml/username")
  attrEmail       String   @default("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress")
  attrDisplayName String   @default("http://schemas.goauthentik.io/2021/02/saml/displayname")
  attrRole        String?
  roleAdminValue  String?
  updatedAt       DateTime @updatedAt
}
