# syntax=docker/dockerfile:1.4
# Node 20 reached end-of-life in April 2026. The eol job in CI fails 60 days
# before this line does.
FROM node:22-bookworm-slim AS base
# The npm bundled with the Node image lags behind and prints upgrade notices
# on every npx invocation at container start.
RUN npm install -g npm@11 && corepack enable && corepack prepare pnpm@9 --activate

# Install system deps: openssl (Prisma), ffmpeg (audio), python3 (yt-dlp)
# yt-dlp lives in its own venv instead of polluting the system Python
# (avoids --break-system-packages). upgrade: the slim base image lags behind
# Debian's security updates.
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
      openssl \
      ffmpeg \
      python3 \
      python3-venv \
      ca-certificates \
    && python3 -m venv /opt/yt-dlp \
    && /opt/yt-dlp/bin/pip install --no-cache-dir -U "yt-dlp[default]" \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/yt-dlp/bin:$PATH"

WORKDIR /app

FROM base AS build
# Toolchain for native modules (@discordjs/opus compiles from source);
# build stage only — the production stage copies the compiled node_modules.
RUN apt-get update && \
    apt-get install -y --no-install-recommends build-essential && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Dependency layer: copy ONLY the workspace manifests + lockfile, then install.
# This layer — which includes the slow native compilation of @discordjs/opus —
# is cached by BuildKit and only re-runs when a package.json or the lockfile
# changes, NOT on every source edit. (Previously a single `COPY . .` before the
# install invalidated this on any file change, recompiling opus every build.)
# Trailing-slash destinations are the BuildKit-safe form for copying a single
# file into a nested path; node_modules is excluded via .dockerignore so the
# later `COPY . .` never clobbers the installed (Linux-compiled) modules.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY packages/common/package.json   ./packages/common/
COPY packages/backend/package.json  ./packages/backend/
COPY packages/frontend/package.json ./packages/frontend/
RUN pnpm install --no-frozen-lockfile

# Source layer: bring in the rest and build. A code-only change invalidates
# from here down and reuses the cached dependency layer above.
COPY . .
RUN pnpm --filter @ts6/common run build
RUN pnpm --filter @ts6/backend exec prisma generate
RUN pnpm --filter @ts6/backend run build

# Production image
FROM base AS production
ENV NODE_ENV=production
WORKDIR /app

COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/package.json ./package.json
COPY --from=build /app/pnpm-workspace.yaml ./pnpm-workspace.yaml
COPY --from=build /app/packages/common/dist ./packages/common/dist
COPY --from=build /app/packages/common/package.json ./packages/common/package.json
COPY --from=build /app/packages/backend/dist ./packages/backend/dist
COPY --from=build /app/packages/backend/generated ./packages/backend/generated
COPY --from=build /app/packages/backend/prisma ./packages/backend/prisma
COPY --from=build /app/packages/backend/prisma.config.ts ./packages/backend/prisma.config.ts
COPY --from=build /app/packages/backend/package.json ./packages/backend/package.json
COPY --from=build /app/packages/backend/node_modules ./packages/backend/node_modules

WORKDIR /app/packages/backend
# Run as the unprivileged 'node' user shipped with the base image.
# Only chown the paths node actually writes to (SQLite data, music, yt-dlp
# config + venv). The app code / node_modules stay root-owned but are
# world-readable, so node reads them fine — chowning all of /app recursively
# (tens of thousands of node_modules files) was the slow build step.
RUN mkdir -p data /data/music /home/node/.config/yt-dlp && \
    echo "--js-runtimes node" > /home/node/.config/yt-dlp/config && \
    chown -R node:node data /data/music /home/node/.config /opt/yt-dlp
USER node
ENV HOME=/home/node

EXPOSE 3001
ENV SIDECAR_URL=http://ts6-sidecar:9800
# The Prisma 7 major upgrade is a deliberate migration, not a container-start
# decision — silence the CLI update banner until then.
ENV PRISMA_HIDE_UPDATE_MESSAGE=1
# Refresh yt-dlp on every start (best effort): YouTube breaks stale versions
# within weeks, and the image is only rebuilt occasionally.
CMD ["sh", "-c", "(pip install --no-cache-dir -qU 'yt-dlp[default]' || true) && npx prisma db push --skip-generate && npx prisma db seed || true && node dist/index.js"]
